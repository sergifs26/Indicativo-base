{% comment %}
  «Más equipo de <entorno>» en la ficha: productos de la colección del primer entorno del
  producto (etiquetas entorno:… de scripts/entornos.py), sin repetir el que se está viendo.
  Si el producto no tiene entorno, la sección no se pinta.
{% endcomment %}
{%- liquid
  assign mapa = 'montana:montana|nautica:nautica|nieve:nieve|camping:camping-y-familia|caza-pesca:caza-y-pesca' | split: '|'
  assign coleccion = blank
  for e in mapa
    assign partes = e | split: ':'
    assign tag = 'entorno:' | append: partes[0]
    if product.tags contains tag
      assign coleccion = collections[partes[1]]
      break
    endif
  endfor
-%}

{%- if coleccion != blank and coleccion.products_count > 1 -%}
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'section-related-products.css' | asset_url | stylesheet_tag }}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="related-products ib-mas-entorno page-width section-{{ section.id }}-padding isolate">
      <div class="ib-mas-entorno__cabecera">
        <h2 class="related-products__heading h2">Más equipo de {{ coleccion.title | downcase }}</h2>
        <a class="ib-mas-entorno__todo link underlined-link" href="{{ coleccion.url }}">Ver todo</a>
      </div>
      <ul class="grid product-grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--2-col-tablet-down" role="list">
        {%- assign mostrados = 0 -%}
        {%- for p in coleccion.products limit: 12 -%}
          {%- if p.id != product.id and mostrados < section.settings.products_to_show -%}
            {%- assign mostrados = mostrados | plus: 1 -%}
            <li class="grid__item">
              {% render 'card-product',
                card_product: p,
                media_aspect_ratio: 'square',
                show_secondary_image: false,
                show_vendor: true,
                show_rating: false
              %}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Más del entorno",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Productos de la colección del primer entorno del producto (Montaña, Náutica, Nieve, Camping y familia o Caza y pesca)."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Productos"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columnas en escritorio"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        { "value": "accent-1", "label": "Acento 1" },
        { "value": "accent-2", "label": "Acento 2" },
        { "value": "background-1", "label": "Fondo 1" },
        { "value": "background-2", "label": "Fondo 2" },
        { "value": "inverse", "label": "Inverso" }
      ],
      "default": "background-1",
      "label": "Esquema de color"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "Margen superior"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "Margen inferior"
    }
  ]
}
{% endschema %}
