# === Salidas regenerables de los scripts ===
# data/ se regenera con la cadena scripts/limpiar_catalogo.py → precios_icom.py → exportar_shopify.py.
# Solo se versionan los ficheros editados A MANO (fuente de verdad), listados abajo con "!".
data/*
!data/precios_icom_revisado.csv
!data/entornos_excepciones.csv
.cache/
scripts/out/
tmp/
*.log

