# === Configuración local de los scripts de Indicativo Base ===
# Copia este archivo como ".env". El ".env" está en .gitignore y NUNCA se sube a GitHub.
#
# La vía normal para la Admin API es la CLI de Shopify (no necesita credenciales aquí):
#   shopify store auth --store indicativo-base.myshopify.com --scopes <scopes>
# Ver scripts/README.md.

# Alias myshopify de la tienda (nunca el dominio propio, que puede cambiar)
SHOPIFY_STORE=indicativo-base.myshopify.com

# Versión de la Admin API. Vacío = la última estable que use la CLI.
SHOPIFY_API_VERSION=

# Carpeta con los ficheros de proveedor (Excel de Pihernz, tarifas PDF).
# Vacío = carpeta padre del repo.
INDICATIVO_FUENTES=
