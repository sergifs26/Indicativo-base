{%- comment -%}
  Un desplegable de la descripción (lo usa snippets/descripcion-desplegable.liquid).
  Parámetros: titulo, cuerpo (HTML), id (único en la página).
  No pinta nada si el cuerpo no tiene texto, tabla ni imagen.
{%- endcomment -%}
{%- assign texto = cuerpo | strip_html | replace: '&nbsp;', '' | strip -%}
{%- if texto != blank or cuerpo contains '<table' or cuerpo contains '<img' -%}
  <div class="product__accordion accordion">
    <details id="{{ id }}">
      <summary>
        <div class="summary__title">
          <h2 class="h4 accordion__title">{{ titulo }}</h2>
        </div>
        {% render 'icon-caret' %}
      </summary>
      <div class="accordion__content rte">
        {{ cuerpo }}
      </div>
    </details>
  </div>
{%- endif -%}
