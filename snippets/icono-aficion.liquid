{% comment %}
  Iconos de línea propios (24 × 24, trazo del color del texto) para el dial «Sintoniza tu afición»
  y los pilares de la portada. Uso: {% render 'icono-aficion', icono: 'torre' %}
  Aficiones: torre, montana, nautica, outdoor, aviacion, caza. Pilares: grupo, ayuda, radio, hoja.
{% endcomment %}
<svg class="ib-icono" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case icono -%}
    {%- when 'torre' -%}
      <path d="M12 9.5V21M8.5 21 12 9.5 15.5 21M9.7 17h4.6"/>
      <circle cx="12" cy="7.5" r="1.4"/>
      <path d="M8.6 4.5a4.2 4.2 0 0 0 0 6M15.4 4.5a4.2 4.2 0 0 1 0 6M5.9 2.5a7.5 7.5 0 0 0 0 10M18.1 2.5a7.5 7.5 0 0 1 0 10"/>
    {%- when 'montana' -%}
      <path d="M2.5 20 9 8.5l3.2 5.2L15 9.5 21.5 20z"/>
      <path d="m7.1 11.9 1.9 1.3 1.4-1.2"/>
    {%- when 'nautica' -%}
      <path d="M12 3v13M12 4.5 18 14h-6M11 7.5 6.5 14H11"/>
      <path d="M3.5 16.5h17l-2.3 3.5H5.8z"/>
    {%- when 'outdoor' -%}
      <path d="M3.5 20 12 5.5 20.5 20M9.2 20 12 15l2.8 5M2 20h20"/>
      <path d="M18.5 3.5v2M17.5 4.5h2"/>
    {%- when 'aviacion' -%}
      <path d="M10.5 9V4.2a1.5 1.5 0 0 1 3 0V9l7.5 4.5v1.8l-7.5-2.2v4.6l2 1.6V21L12 20l-3.5 1v-1.7l2-1.6v-4.6L3 15.3v-1.8z"/>
    {%- when 'caza' -%}
      <circle cx="6.5" cy="15.5" r="3.5"/>
      <circle cx="17.5" cy="15.5" r="3.5"/>
      <path d="M10 15.5h4M3.6 13.2 5.7 6a1.4 1.4 0 0 1 1.3-1h1.7A1.3 1.3 0 0 1 10 6.3V15M20.4 13.2 18.3 6a1.4 1.4 0 0 0-1.3-1h-1.7A1.3 1.3 0 0 0 14 6.3V15"/>
    {%- when 'grupo' -%}
      <circle cx="12" cy="7.5" r="3"/>
      <path d="M6.5 20a5.5 5.5 0 0 1 11 0"/>
      <circle cx="5" cy="9.5" r="2"/>
      <path d="M1.5 18a3.5 3.5 0 0 1 4.6-3.3"/>
      <circle cx="19" cy="9.5" r="2"/>
      <path d="M22.5 18a3.5 3.5 0 0 0-4.6-3.3"/>
    {%- when 'ayuda' -%}
      <path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.5 2.6C19.5 15.4 12 20 12 20z"/>
      <path d="M8.5 12h2l1-2 1.5 4 1-2h1.5"/>
    {%- when 'radio' -%}
      <rect x="7" y="8" width="10" height="13" rx="2"/>
      <path d="M14.5 8V2.5M9.5 12h5M9.5 15h5M9.5 18h2.5"/>
    {%- when 'hoja' -%}
      <path d="M5 19C5 11 10 6 19.5 5c0 9.5-5 14-14.5 14z"/>
      <path d="m5 19 8.5-8.5"/>
    {%- else -%}
      <circle cx="12" cy="12" r="8"/>
  {%- endcase -%}
</svg>
